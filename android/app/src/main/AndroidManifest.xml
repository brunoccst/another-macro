<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- auto-update: check GitHub Releases, download and install the new APK -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- turn the screen on and keep it on while Claude or a macro drives the game (ScreenWake) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />

    <!-- Android 11+ package visibility: needed to launch the game -->
    <queries>
        <package android:name="games.wfs.anothereden" />
    </queries>

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- turns the screen on when a wake lock can't; a task of its own, so the game comes back in front -->
        <activity
            android:name=".WakeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="io.github.brunoccst.anothermacro.wake"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".Updater$InstallResult"
            android:exported="false" />

        <!-- screen capture runs in a foreground service (required for MediaProjection) -->
        <service
            android:name=".MacroService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- taps, holds/slides (walking) and Back, via accessibility gestures -->
        <service
            android:name=".InputService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/input_service" />
        </service>
    </application>
</manifest>
