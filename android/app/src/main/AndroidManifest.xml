<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- auto-update: check GitHub Releases, download and install the new APK -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- recording a run (⏺): Termux reads the touchscreen through ADB (see Termux.kt) -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Android 11+ package visibility: needed to launch the game, and to find Termux -->
    <queries>
        <package android:name="games.wfs.anothereden" />
        <package android:name="com.termux" />
    </queries>

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CaptureActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- pair the app's own ADB with Wireless debugging (recording runs) -->
        <activity
            android:name=".AdbSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <receiver
            android:name=".AdbPairReceiver"
            android:exported="false" />

        <!-- name a recording made with the floating ⏺ button -->
        <activity
            android:name=".RecordingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <receiver
            android:name=".Updater$InstallResult"
            android:exported="false" />

        <!-- screen capture runs in a foreground service (required for MediaProjection) -->
        <service
            android:name=".MacroService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- taps, holds/slides (walking) and Back, via accessibility gestures -->
        <service
            android:name=".InputService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/input_service" />
        </service>
    </application>
</manifest>
